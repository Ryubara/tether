{
  "fleet": {
    "cacheTtlMinutes": 60,
    "bigContextTokens": 60000,
    "retireContextTokens": 300000,
    "coldGuard": true,
    "columnTint": true,
    "refreshSeconds": 15
  },
  "checkpoint": {
    "enabled": false,
    "contextTokens": 200000,
    "quietSeconds": 90,
    "handoffFile": "HANDOFF.md",
    "maxChars": 9500,
    "sections": [
      "## Where to look",
      "## Summary",
      "## Next steps",
      "## Open questions"
    ],
    "maxRepairs": 3
  },
  "watch": {
    "tickSeconds": 1,
    "boxRows": 6,
    "pollers": [
      {
        "id": "agents",
        "kind": "agents",
        "title": "Subagents",
        "everySeconds": 60,
        "silentMinutes": 45
      },
      {
        "id": "prs",
        "kind": "prs",
        "title": "Open pull requests",
        "everySeconds": 300,
        "stuckMinutes": 90,
        "requireAutoMerge": false,
        "ignoreDrafts": true,
        "assignHours": 4,
        "rerunHours": 3
      }
    ]
  },
  "housekeeping": {
    "enabled": true,
    "folder": ".tether",
    "exclude": [],
    "createHandoff": true,
    "enforceHandoff": true
  },
  "conversations": {
    "enabled": true,
    "minSeconds": 30
  },
  "stop": {
    "enabled": true,
    "maxBlocks": 3
  },
  "cacheGuard": {
    "auto": true,
    "leadMinutes": 20,
    "handoverTokens": 250000,
    "sizeHandover": true,
    "handoverWaitMinutes": 10,
    "keepWarmMax": 12,
    "keepWarmText": "Tether cache guard: keep waiting, no action needed. Reply with one word, then wait as before.",
    "handoverText": "Tether cache guard: hand over now. Commit your work, update STATUS.md (tip, done, left, running background jobs and their logs or result files, the next exact command), then stop. Do not start new work."
  }
}
