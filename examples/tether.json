{
  "fleet": {
    "cacheTtlMinutes": 60,
    "bigContextTokens": 60000,
    "retireContextTokens": 300000,
    "coldGuard": true,
    "columnTint": true,
    "refreshSeconds": 15
  },
  "checkpoint": {
    "enabled": false,
    "contextTokens": 200000,
    "quietSeconds": 90,
    "handoffFile": "HANDOFF.md",
    "maxChars": 9500,
    "sections": [
      "## Where to look",
      "## Summary",
      "## Next steps",
      "## Open questions"
    ],
    "maxRepairs": 3
  },
  "watch": {
    "tickSeconds": 1,
    "boxRows": 6,
    "pollers": [
      {
        "id": "agents",
        "kind": "agents",
        "title": "Subagents",
        "everySeconds": 60,
        "silentMinutes": 45,
        "contextTokens": 300000
      },
      {
        "id": "prs",
        "kind": "prs",
        "title": "Open pull requests",
        "everySeconds": 300,
        "stuckMinutes": 90,
        "requireAutoMerge": false,
        "ignoreDrafts": true,
        "assignHours": 4,
        "rerunHours": 3
      }
    ]
  },
  "housekeeping": {
    "enabled": true,
    "folder": ".tether",
    "exclude": [],
    "createHandoff": true,
    "enforceHandoff": true
  },
  "conversations": {
    "enabled": true,
    "minSeconds": 30
  },
  "stop": {
    "enabled": true,
    "maxBlocks": 3
  }
}
